# ============================================
# AI Provider Configuration
# ============================================
# Choose your provider: gemini, openai, anthropic, lmstudio, ollama, custom
AI_PROVIDER=gemini

# ============================================
# Option 1: Google Gemini (default - has a free tier)
# ============================================
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Cheapest current model. ~$0.25 in / $1.50 out per 1M tokens,
# and free up to the daily free-tier limit.
MODEL=gemini-3.1-flash-lite

# Other options, cheapest first:
# MODEL=gemini-3.5-flash-lite
# MODEL=gemini-3.6-flash          # smartest, ~6x the price of flash-lite
#
# NOTE: gemini-1.5-* and gemini-2.5-* are retired and return a 404
# ("no longer available to new users"). Don't use them.
#
# Uses the Interactions API: https://ai.google.dev/api/interactions-api

# ============================================
# Option 2: OpenAI
# ============================================
# Get key at: https://platform.openai.com/api-keys
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_key_here
# MODEL=gpt-4o-mini

# ============================================
# Option 3: Anthropic Claude
# ============================================
# Get key at: https://platform.claude.com/
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_key_here
# MODEL=claude-haiku-4-5

# ============================================
# Option 4: LM Studio (Local Models - free, no key)
# ============================================
# Download LM Studio: https://lmstudio.ai/
# AI_PROVIDER=lmstudio
# LM_STUDIO_URL=http://localhost:1234/v1
# MODEL=local-model

# ============================================
# Option 5: Ollama (Local Models - free, no key)
# ============================================
# Install Ollama: https://ollama.ai/  then: ollama pull qwen2.5
# AI_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434/v1
# MODEL=qwen2.5:latest

# ============================================
# Option 6: Custom OpenAI-Compatible API
# ============================================
# AI_PROVIDER=custom
# CUSTOM_BASE_URL=http://your-server:port/v1
# CUSTOM_API_KEY=your_key_here
# MODEL=your-model-name

# ============================================
# Browser settings
# ============================================
# Audits run headless by default - it's faster and the numbers are steadier.
# Set to false if you want to watch the page load.
HEADLESS=false
